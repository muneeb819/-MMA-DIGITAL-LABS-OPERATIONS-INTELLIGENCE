# ---------------------------------------------------------------------------
# BPO Adriene Playground - backend-only environment
# This file is gitignored and blocked by the static file server.
# Never copy these values into assets/js/*.js or any HTML file.
# ---------------------------------------------------------------------------

# Deepgram Aura TTS (/api/tts) + Nova-2 STT (/api/stt)
DEEPGRAM_API_KEY=2aab62fcb7cee41a9f1e4d36b6e1fefb6a31d75c

# Optional provider connection tests (audio is not sent by this build)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Localhost bearer gate is off by default.
AUTH_ENABLED=false
AUTH_SECRET=

# Live SIP/PSTN remains blocked in this build.
TELEPHONY_ENABLED=false

# Default HTTP port. The launcher falls back to the next free port.
PORT=8000
